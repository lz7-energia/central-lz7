# Copie para .env.local e preencha. NUNCA envie o arquivo preenchido ao repositório.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API do Flow (somente leitura)
FLOW_API_BASE_URL=https://api.flow2.com.br/v1
FLOW_API_TOKEN=

# E-mail (Titan)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_REMETENTE=

# Endereço público do site (links dos e-mails), ex.: https://central.lz7energia.com.br
SITE_URL=

# Anti-robô do portal (Cloudflare Turnstile, gratuito). Sem as chaves, fica desligado.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
